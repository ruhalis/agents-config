# Model mapping for generated Codex subagents.
#
# core/agents/*.md carry Claude model names in frontmatter. Only the cheap tier
# is mapped: agents with `model: sonnet` become CODEX_FAST_MODEL. Agents with no
# `model:` field inherit the session model, so nothing is emitted for them.

CODEX_FAST_MODEL="gpt-5.4-mini"
